# Copy to .env and adjust. Debug is off unless explicitly enabled.
# Production keys must be at least 50 characters and unique to this deployment.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required in production: encrypts stored MFA secrets and integration credentials.
# Generate once and keep it stable; rotating it invalidates existing encrypted values.
SORA_SECRET_ENCRYPTION_KEY=
# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY_HEADERS=0
# Public origin for helpdesk client links (status, confirmation, satisfaction survey).
# Leave blank to derive links from the incoming request host.
SORA_PUBLIC_BASE_URL=https://erp.example.com

# PostgreSQL 16 (recommended)
DATABASE_URL=postgresql://sora:sora@127.0.0.1:5432/sora_erp

# For quick local runs without PostgreSQL uncomment:
# DATABASE_URL=sqlite:///db.sqlite3

TIME_ZONE=Africa/Nairobi

# Mail (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@sora.com

# Integrations (optional)
OPENAI_API_KEY=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
